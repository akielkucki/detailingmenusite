---
// Shared sub-page shell: one full-size pause-menu panel matching the
// dashboard cards — glass surface, square corners, clip reveal via the shared
// .menu-card timeline, and the same 90px logo notch on lg. The panel height is
// fixed at every breakpoint so the page body never scrolls; content scrolls
// inside the .panel-scroll body instead.
interface Props {
    title: string;
    eyebrow?: string;
}
const { title, eyebrow } = Astro.props;
---
<main class="min-h-dvh p-4 pt-[6.625rem] sm:p-6 sm:pt-[7.125rem] lg:pt-6">
    <div class="mx-auto h-[calc(100dvh-13.625rem)] max-w-[135rem] sm:h-[calc(100dvh-14.125rem)] lg:h-[calc(100dvh-8.5rem)]">
        <div class="menu-card relative h-full [clip-path:inset(100%_0%_0%_0%)]">
            <div class="absolute inset-0 flex flex-col overflow-hidden rounded-[3px] bg-black/55 backdrop-blur-md lg:[clip-path:polygon(90px_0,100%_0,100%_100%,0_100%,0_90px,90px_90px)]">
                <div class="flex items-start justify-between gap-4 border-b border-white/10 p-5 sm:p-6 lg:min-h-[5.625rem] lg:items-center lg:pl-[6.875rem]">
                    <div>
                        {eyebrow && <p class="text-xs text-white/70">{eyebrow}</p>}
                        <h1 class="text-3xl font-semibold tracking-tight sm:text-4xl">{title}</h1>
                    </div>
                    <span class="grid size-9 shrink-0 place-items-center rounded-[3px] bg-accent text-black">
                        <slot name="icon" />
                    </span>
                </div>
                <div class="panel-scroll min-h-0 flex-1 overflow-y-auto p-5 sm:p-8 xl:p-10">
                    <slot />
                </div>
            </div>
        </div>
    </div>
</main>

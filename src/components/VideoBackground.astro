---
// Fixed video background shared by all pages. transition:persist keeps the
// same <video> element (and its playback position) alive across view
// transitions — on /dashboard it is paused, leaving the last frame visible
// behind the blur.
---
<div transition:persist="video-bg" class="pointer-events-none fixed inset-0 -z-[1] overflow-hidden bg-dark-grey">
    <video
        data-hero-video
        class="absolute top-1/2 left-1/2 h-full w-full object-cover will-change-[filter,transform]"
        loop muted autoplay playsinline
    >
        <source src="/hero.mp4" type="video/mp4">
    </video>
    <div class="absolute inset-0 bg-black/40"></div>
</div>

<script>
    import gsap from "gsap";

    const sync = () => {
        const video = document.querySelector<HTMLVideoElement>("[data-hero-video]");
        if (!video) return;

        // Size once to the physical screen so window resizes only crop the
        // video (via the overflow-hidden container) instead of rescaling it.
        // GSAP owns the transform, so centering is set here too.
        if (!video.dataset.sized) {
            video.dataset.sized = "1";
            video.style.width = `${Math.max(screen.width, window.innerWidth)}px`;
            video.style.height = `${Math.max(screen.height, window.innerHeight)}px`;
            gsap.set(video, { xPercent: -50, yPercent: -50 });
        }

        if (window.location.pathname.startsWith("/dashboard")) {
            video.pause();
            gsap.to(video, { scale: 1.1, filter: "blur(24px) brightness(0.35)", duration: 0.9, ease: "expo.out" });
        } else {
            video.play();
            gsap.to(video, { scale: 1, filter: "blur(0px) brightness(1)", duration: 0.9, ease: "expo.out" });
        }
    };

    document.addEventListener("astro:page-load", sync);
</script>

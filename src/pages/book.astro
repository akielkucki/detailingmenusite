---
import Layout from "../layouts/Layout.astro";
import PagePanel from "../components/PagePanel.astro";

const inputClass = "w-full rounded-[3px] border border-white/15 bg-black/40 px-4 py-3 text-base text-white outline-none transition-colors placeholder:text-white/40 focus:border-accent";
const labelClass = "mb-2 block text-xs font-medium text-white/70";
---
<Layout title="Book a Detail — Bucks County Detailing">
    <PagePanel title="Book a Detail" eyebrow="Scheduling">
        <svg slot="icon" class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="3" y="4" width="18" height="17" rx="2"/><path d="M8 2v4M16 2v4M3 9h18"/>
        </svg>

        <div class="grid gap-10 lg:grid-cols-[1.2fr_1fr]">
            <form data-book-form class="max-w-3xl">
                <p class="text-base leading-relaxed text-white/85 sm:text-lg">
                    Tell us about your car and when you'd like to come in — we'll confirm
                    your slot by email within one business day.
                </p>

                <div class="mt-8 grid gap-5 sm:grid-cols-2">
                    <div>
                        <label for="book-name" class={labelClass}>Full name</label>
                        <input id="book-name" name="name" type="text" required placeholder="Jamie Rivera" class={inputClass}/>
                    </div>
                    <div>
                        <label for="book-phone" class={labelClass}>Phone</label>
                        <input id="book-phone" name="phone" type="tel" placeholder="(215) 555-0134" class={inputClass}/>
                    </div>
                    <div class="sm:col-span-2">
                        <label for="book-email" class={labelClass}>Email</label>
                        <input id="book-email" name="email" type="email" required placeholder="you@example.com" class={inputClass}/>
                    </div>
                    <div class="sm:col-span-2">
                        <label for="book-vehicle" class={labelClass}>Vehicle (year / make / model)</label>
                        <input id="book-vehicle" name="vehicle" type="text" required placeholder="2022 Porsche 911 GT3" class={inputClass}/>
                    </div>
                    <div>
                        <label for="book-service" class={labelClass}>Service</label>
                        <select id="book-service" name="service" class={inputClass}>
                            <option>Essential — $149</option>
                            <option selected>Signature — $249</option>
                            <option>Showroom — $449</option>
                            <option>Interior only</option>
                            <option>Exterior only</option>
                            <option>Ceramic coating consult</option>
                        </select>
                    </div>
                    <div>
                        <label for="book-date" class={labelClass}>Preferred date</label>
                        <input id="book-date" name="date" type="date" class={inputClass}/>
                    </div>
                    <div class="sm:col-span-2">
                        <label for="book-notes" class={labelClass}>Anything we should know?</label>
                        <textarea id="book-notes" name="notes" rows="5" placeholder="Pet hair in the back seats, water spots on the hood…" class={inputClass}></textarea>
                    </div>
                </div>

                <button type="submit" class="mt-8 inline-flex cursor-pointer items-center gap-2 rounded-[3px] bg-accent px-7 py-3.5 text-base font-medium text-black transition-all hover:brightness-90">
                    Request Appointment
                    <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M7 17L17 7M8 7h9v9"/>
                    </svg>
                </button>
                <p data-book-confirm hidden class="mt-5 rounded-[3px] border border-accent/40 bg-accent/10 px-5 py-4 text-base text-accent">
                    Request received — we'll email you within one business day to confirm.
                </p>
            </form>

            <aside class="space-y-3">
                <div class="rounded-[3px] border border-white/10 bg-black/40 p-6">
                    <h2 class="text-base font-semibold tracking-tight">Good to know</h2>
                    <ul class="mt-4 space-y-3 text-sm leading-relaxed text-white/70">
                        <li>Most details take 3–6 hours; ceramic coatings are an overnight stay.</li>
                        <li>Drop-off from 8:00 AM — comfortable lounge and Wi-Fi if you'd rather wait.</li>
                        <li>Rescheduling is free with 24 hours' notice.</li>
                    </ul>
                </div>
                <div class="rounded-[3px] border border-white/10 bg-black/40 p-6">
                    <h2 class="text-base font-semibold tracking-tight">How booking works</h2>
                    <ol class="mt-4 space-y-3 text-sm leading-relaxed text-white/70">
                        <li class="flex gap-3"><span class="grid size-5 shrink-0 place-items-center rounded-[3px] bg-accent text-[11px] font-semibold text-black">1</span>Send the request with your preferred date.</li>
                        <li class="flex gap-3"><span class="grid size-5 shrink-0 place-items-center rounded-[3px] bg-accent text-[11px] font-semibold text-black">2</span>We confirm the slot and a firm quote by email.</li>
                        <li class="flex gap-3"><span class="grid size-5 shrink-0 place-items-center rounded-[3px] bg-accent text-[11px] font-semibold text-black">3</span>Drop the car off — pay at pickup, only if you're happy.</li>
                    </ol>
                </div>
                <div class="rounded-[3px] border border-white/10 bg-black/40 p-6">
                    <h2 class="text-base font-semibold tracking-tight">Prefer to talk?</h2>
                    <p class="mt-3 text-sm leading-relaxed text-white/70">
                        Call or text <span class="text-white">(215) 555-0198</span> — we're
                        in the shop Monday through Saturday.
                    </p>
                    <a href="/contact" class="mt-3 inline-block text-sm text-white/80 underline underline-offset-4 transition-colors hover:text-white">All contact options</a>
                </div>
                <div class="rounded-[3px] border border-white/10 bg-black/40 p-6">
                    <h2 class="text-base font-semibold tracking-tight">Not sure what to pick?</h2>
                    <p class="mt-3 text-sm leading-relaxed text-white/70">
                        Choose the closest option and describe the car in the notes — we'll
                        recommend the right package in the confirmation, never upsell past
                        what the car needs.
                    </p>
                    <a href="/services" class="mt-3 inline-block text-sm text-white/80 underline underline-offset-4 transition-colors hover:text-white">Compare packages</a>
                </div>
            </aside>
        </div>
    </PagePanel>
</Layout>

<script>
    // Placeholder handler until real scheduling is wired up: swallow the
    // submit and show the confirmation note instead of navigating.
    document.addEventListener("astro:page-load", () => {
        const form = document.querySelector<HTMLFormElement>("[data-book-form]");
        if (!form) return;
        form.addEventListener("submit", (e) => {
            e.preventDefault();
            form.querySelector("[data-book-confirm]")?.removeAttribute("hidden");
        });
    });
</script>

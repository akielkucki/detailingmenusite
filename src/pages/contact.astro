---
import Layout from "../layouts/Layout.astro";
import PagePanel from "../components/PagePanel.astro";

const inputClass = "w-full rounded-[3px] border border-white/15 bg-black/40 px-4 py-3 text-base text-white outline-none transition-colors placeholder:text-white/40 focus:border-accent";
const labelClass = "mb-2 block text-xs font-medium text-white/70";

const hours = [
    ["Monday – Friday", "8:00 AM – 6:00 PM"],
    ["Saturday", "8:00 AM – 4:00 PM"],
    ["Sunday", "Closed"],
];
---
<Layout title="Contact Us — Bucks Premium Detailing">
    <PagePanel title="Contact Us" eyebrow="Get in Touch">
        <svg slot="icon" class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M22 2L11 13M22 2l-7 20-4-9-9-4z"/>
        </svg>

        <div class="grid gap-10 lg:grid-cols-[1fr_1.2fr] overflow-x-hidden">
            <div class="space-y-3">
                <div class="rounded-[3px] border border-white/10 bg-black/40 p-6">
                    <h2 class="text-base font-semibold tracking-tight">The shop</h2>
                    <p class="mt-4 text-base leading-relaxed text-white/85">
                        214 Mill Creek Road<br/>
                        Doylestown, PA 18901
                    </p>
                    <p class="mt-3 text-sm leading-relaxed text-white/70">
                        Two minutes off Route 611 — look for the black building with the
                        yellow bay doors.
                    </p>
                </div>

                <div class="rounded-[3px] border border-white/10 bg-black/40 p-6">
                    <h2 class="text-base font-semibold tracking-tight">Reach us</h2>
                    <ul class="mt-4 space-y-3 text-base text-white/85">
                        <li>Phone / text: <a href="tel:+12155550198" class="underline underline-offset-4 transition-colors hover:text-white">(215) 555-0198</a></li>
                        <li>Email: <a href="mailto:hello@buckspremiumdetailing.com" class="underline underline-offset-4 transition-colors hover:text-white">hello@buckspremiumdetailing.com</a></li>
                        <li class="flex gap-5 pt-1">
                            <a href="https://instagram.com" target="_blank" rel="noopener" class="text-sm text-white/70 underline underline-offset-4 transition-colors hover:text-white">Instagram</a>
                            <a href="https://facebook.com" target="_blank" rel="noopener" class="text-sm text-white/70 underline underline-offset-4 transition-colors hover:text-white">Facebook</a>
                        </li>
                    </ul>
                </div>

                <div class="rounded-[3px] border border-white/10 bg-black/40 p-6">
                    <h2 class="text-base font-semibold tracking-tight">Hours</h2>
                    <dl class="mt-4 space-y-3">
                        {hours.map(([day, time]) => (
                            <div class="flex items-center justify-between text-base">
                                <dt class="text-white/70">{day}</dt>
                                <dd class:list={["font-medium", time === "Closed" ? "text-white/50" : "text-white/85"]}>{time}</dd>
                            </div>
                        ))}
                    </dl>
                </div>

                <div class="rounded-[3px] border border-white/10 bg-black/40 p-6">
                    <h2 class="text-base font-semibold tracking-tight">Service area</h2>
                    <p class="mt-3 text-sm leading-relaxed text-white/70">
                        Based in Doylestown, serving all of Bucks County — Newtown, New Hope,
                        Warrington, Chalfont, Perkasie — plus nearby Montgomery County.
                    </p>
                </div>
            </div>

            <form data-contact-form class="relative max-w-3xl">
                <h2 class="text-xl font-semibold tracking-tight sm:text-2xl">Send a message</h2>
                <p class="mt-2 text-sm text-white/70">Questions about a quote, your vehicle, or something we didn't cover — we usually reply the same day.</p>

                <div class="mt-7 grid gap-5 sm:grid-cols-2">
                    <div>
                        <label for="contact-name" class={labelClass}>Name</label>
                        <input id="contact-name" name="name" type="text" required maxlength="100" placeholder="Jamie Rivera" class={inputClass}/>
                    </div>
                    <div>
                        <label for="contact-email" class={labelClass}>Email</label>
                        <input id="contact-email" name="email" type="email" required maxlength="200" placeholder="you@example.com" class={inputClass}/>
                    </div>
                    <div class="sm:col-span-2">
                        <label for="contact-message" class={labelClass}>Message</label>
                        <textarea id="contact-message" name="message" rows="8" required maxlength="5000" placeholder="How can we help?" class={inputClass}></textarea>
                    </div>
                </div>

                <!-- Spam trap: visually hidden and skipped by keyboard/screen readers -->
                <div class="absolute -left-[9999px]" aria-hidden="true">
                    <label for="contact-company">Company</label>
                    <input id="contact-company" name="company" type="text" tabindex="-1" autocomplete="off"/>
                </div>

                <button type="submit" data-contact-submit class="mt-7 inline-flex cursor-pointer items-center gap-2 rounded-[3px] bg-accent px-7 py-3.5 text-base font-medium text-black transition-all hover:brightness-90 disabled:cursor-not-allowed disabled:opacity-60">
                    <span data-contact-submit-label>Send Message</span>
                    <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M7 17L17 7M8 7h9v9"/>
                    </svg>
                </button>
                <p data-contact-status hidden role="status" aria-live="polite" class="mt-5 rounded-[3px] border px-5 py-4 text-base"></p>
            </form>
        </div>
    </PagePanel>
</Layout>

<script>
    // Submits to /api/contact, which relays the message through Resend.
    const OK_CLASS = "border-accent/40 bg-accent/10 text-accent";
    const ERR_CLASS = "border-red-400/40 bg-red-400/10 text-red-300";

    document.addEventListener("astro:page-load", () => {
        const form = document.querySelector<HTMLFormElement>("[data-contact-form]");
        if (!form) return;

        const status = form.querySelector<HTMLElement>("[data-contact-status]")!;
        const button = form.querySelector<HTMLButtonElement>("[data-contact-submit]")!;
        const label = form.querySelector<HTMLElement>("[data-contact-submit-label]")!;

        const show = (message: string, ok: boolean) => {
            status.className = `mt-5 rounded-[3px] border px-5 py-4 text-base ${ok ? OK_CLASS : ERR_CLASS}`;
            status.textContent = message;
            status.removeAttribute("hidden");
        };

        form.addEventListener("submit", async (e) => {
            e.preventDefault();
            if (button.disabled) return;

            button.disabled = true;
            label.textContent = "Sending…";
            status.setAttribute("hidden", "");

            try {
                const res = await fetch("/api/contact", {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify(Object.fromEntries(new FormData(form))),
                });
                const data = await res.json().catch(() => ({}));

                if (res.ok) {
                    form.reset();
                    show("Message sent — we'll get back to you shortly.", true);
                } else {
                    show(data.error ?? "Something went wrong. Please try again.", false);
                }
            } catch {
                show("Couldn't reach the server. Check your connection and try again.", false);
            } finally {
                button.disabled = false;
                label.textContent = "Send Message";
            }
        });
    });
</script>

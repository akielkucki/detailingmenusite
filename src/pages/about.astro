---
import Layout from "../layouts/Layout.astro";
import PagePanel from "../components/PagePanel.astro";
import { Image } from "astro:assets";

const stats = [
    ["12+", "Years detailing"],
    ["4,800", "Vehicles detailed"],
    ["5.0", "Average rating"],
    ["2", "Climate-controlled bays"],
];

const testimonials = [
    {
        quote: "They found swirl marks I didn't know existed and made a 9-year-old daily look better than the day I bought it. I don't trust anyone else with the paint now.",
        name: "Mike T.",
        car: "BMW M340i",
    },
    {
        quote: "Kid-destroyed interior, two dogs, three years of commuting. It came back smelling and looking factory-new. Genuinely didn't think that was possible.",
        name: "Sarah K.",
        car: "Honda Pilot",
    },
    {
        quote: "The ceramic coating is a year old and the car still beads like the day it was done. The annual check-up is a nice touch most shops don't bother with.",
        name: "Dan R.",
        car: "Porsche 911 GT3",
    },
];

const faqs = [
    ["Do I need an appointment?", "Yes — we run one car per bay per slot, so everything is by appointment. Booking a week out is usually enough; ceramic work books 2–3 weeks ahead."],
    ["How long does a detail take?", "Most packages run 3–6 hours. Multi-stage correction and ceramic coatings stay overnight so the coating can cure in a controlled environment."],
    ["Do you work on exotics and classics?", "All the time. Soft single-stage paints, delicate brightwork, and originality-sensitive interiors get a documented, test-spot-first approach."],
    ["What if it rains the day after my detail?", "Rain won't hurt anything we've done — every package leaves with protection on the paint. If the car gets genuinely trashed within 48 hours, bring it back and we'll rinse it on the house."],
];
---
<Layout title="What is BCD? — Bucks County Detailing">
    <PagePanel title="What is BCD?" eyebrow="Our Story">
        <svg slot="icon" class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M5 11l1.7-4.2A2 2 0 0 1 8.6 5.5h6.8a2 2 0 0 1 1.9 1.3L19 11M5 11h14M5 11a2 2 0 0 0-2 2v3h2m14-5a2 2 0 0 1 2 2v3h-2m-14 0v2h3v-2m-3 0h14m0 0v2h-3v-2"/>
        </svg>

        <div class="grid gap-10 lg:grid-cols-[1.2fr_1fr]">
            <div class="max-w-3xl">
                <p class="text-base leading-relaxed text-white/85 sm:text-lg">
                    Bucks County Detailing is where obsession meets craft. We started in a
                    two-car garage in Doylestown with a pressure washer, a borrowed polisher,
                    and an unreasonable standard for what "clean" means. A decade later the
                    standard hasn't moved — only the tools have.
                </p>
                <p class="mt-5 text-base leading-relaxed text-white/85">
                    Every vehicle that rolls through our bay gets showroom-level care from
                    detailers who genuinely love cars. No rushed jobs, no skipped steps, no
                    "good enough." Whether it's a daily-driven Civic or a garage-queen GT3,
                    it leaves looking better than the day it was delivered.
                </p>
                <p class="mt-5 text-base leading-relaxed text-white/85">
                    Today we run two climate-controlled bays with dedicated lighting for paint
                    inspection, a wash pad plumbed for filtered water, and a product wall we
                    argue about constantly. It's a small operation on purpose — small enough
                    that the same hands that quote your car are the ones that finish it.
                </p>

                <div class="mt-10 grid grid-cols-2 gap-3 sm:grid-cols-4">
                    {stats.map(([value, label]) => (
                        <div class="rounded-[3px] border border-white/10 bg-black/40 p-5">
                            <p class="text-3xl font-semibold tracking-tight text-accent sm:text-4xl">{value}</p>
                            <p class="mt-2 text-xs text-white/70">{label}</p>
                        </div>
                    ))}
                </div>

                <h2 class="mt-12 text-xl font-semibold tracking-tight sm:text-2xl">How we work</h2>
                <ul class="mt-5 space-y-4">
                    <li class="flex gap-4 text-base text-white/85">
                        <span class="mt-0.5 grid size-6 shrink-0 place-items-center rounded-[3px] bg-accent text-xs font-semibold text-black">1</span>
                        <span><span class="font-medium text-white">One car at a time.</span> Your appointment is your bay — we never stack jobs to squeeze the schedule. The car gets however long it needs.</span>
                    </li>
                    <li class="flex gap-4 text-base text-white/85">
                        <span class="mt-0.5 grid size-6 shrink-0 place-items-center rounded-[3px] bg-accent text-xs font-semibold text-black">2</span>
                        <span><span class="font-medium text-white">Products that earn their place.</span> Everything on the shelf is tested on our own cars before it touches yours. No sponsor deals, no filler steps.</span>
                    </li>
                    <li class="flex gap-4 text-base text-white/85">
                        <span class="mt-0.5 grid size-6 shrink-0 place-items-center rounded-[3px] bg-accent text-xs font-semibold text-black">3</span>
                        <span><span class="font-medium text-white">Walkaround before and after.</span> You see exactly what we found and exactly what we fixed — under the same inspection lights we work by.</span>
                    </li>
                    <li class="flex gap-4 text-base text-white/85">
                        <span class="mt-0.5 grid size-6 shrink-0 place-items-center rounded-[3px] bg-accent text-xs font-semibold text-black">4</span>
                        <span><span class="font-medium text-white">Honest scope.</span> If your paint doesn't need a two-stage correction, we'll tell you — and quote the cheaper package that gets the same result.</span>
                    </li>
                </ul>

                <h2 class="mt-12 text-xl font-semibold tracking-tight sm:text-2xl">What clients say</h2>
                <div class="mt-5 grid gap-3">
                    {testimonials.map((t) => (
                        <blockquote class="rounded-[3px] border border-white/10 bg-black/40 p-6">
                            <svg class="size-5 text-accent" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                                <path d="M10 8c-3 0-5 2.2-5 5.1 0 2 1.4 3.4 3.2 3.4 1.6 0 2.8-1.2 2.8-2.8 0-1.5-1.1-2.6-2.6-2.6h-.3c.3-1.3 1.4-2.3 2.9-2.6zm9 0c-3 0-5 2.2-5 5.1 0 2 1.4 3.4 3.2 3.4 1.6 0 2.8-1.2 2.8-2.8 0-1.5-1.1-2.6-2.6-2.6h-.3c.3-1.3 1.4-2.3 2.9-2.6z"/>
                            </svg>
                            <p class="mt-3 text-base leading-relaxed text-white/85">{t.quote}</p>
                            <footer class="mt-4 text-sm text-white/60">
                                <span class="font-medium text-white/85">{t.name}</span> · {t.car}
                            </footer>
                        </blockquote>
                    ))}
                </div>

                <h2 class="mt-12 text-xl font-semibold tracking-tight sm:text-2xl">Common questions</h2>
                <div class="mt-5 space-y-3">
                    {faqs.map(([q, a]) => (
                        <div class="rounded-[3px] border border-white/10 bg-black/40 p-6">
                            <h3 class="text-base font-medium">{q}</h3>
                            <p class="mt-2 text-sm leading-relaxed text-white/70">{a}</p>
                        </div>
                    ))}
                </div>

                <div class="mt-12 flex flex-wrap items-center gap-5 border-t border-white/10 pt-8">
                    <a href="/book" class="inline-flex items-center gap-2 rounded-[3px] bg-accent px-6 py-3.5 text-base font-medium text-black transition-all hover:brightness-90">
                        Book a Detail
                        <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M7 17L17 7M8 7h9v9"/>
                        </svg>
                    </a>
                    <a href="/services" class="text-base text-white/80 underline underline-offset-4 transition-colors hover:text-white">See packages &amp; pricing</a>
                </div>
            </div>

            <div class="hidden space-y-3 lg:block">
                <figure class="img-wrap relative h-[34rem] overflow-hidden rounded-[3px] opacity-0">
                    <Image src="https://images.pexels.com/photos/6873129/pexels-photo-6873129.jpeg?auto=compress&cs=tinysrgb&w=1600" alt="Detailer polishing a car" width={1600} height={1067} loading={"eager"}
                           class="absolute inset-0 h-full w-full object-cover"/>
                    <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent"></div>
                    <figcaption class="absolute bottom-5 left-5 text-sm text-white/85">Stage-two polish under inspection light</figcaption>
                </figure>
                <figure class="img-wrap relative h-[30rem] overflow-hidden rounded-[3px] opacity-0">
                    <Image src="https://images.pexels.com/photos/5273165/pexels-photo-5273165.jpeg?auto=compress&cs=tinysrgb&w=1200" alt="Finished car in the shop" width={1200} height={1600} loading={"eager"}
                           class="absolute inset-0 h-full w-full object-cover"/>
                    <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent"></div>
                    <figcaption class="absolute bottom-5 left-5 text-sm text-white/85">This month's feature, fresh off the pad</figcaption>
                </figure>
                <div class="rounded-[3px] border border-white/10 bg-black/40 p-6">
                    <h2 class="text-base font-semibold tracking-tight">Visit the shop</h2>
                    <p class="mt-2 text-sm leading-relaxed text-white/70">
                        214 Mill Creek Road, Doylestown, PA. Stop by during shop hours and
                        we'll happily look your car over and talk through what it needs —
                        no appointment required for a quote.
                    </p>
                    <a href="/contact" class="mt-3 inline-block text-sm text-white/80 underline underline-offset-4 transition-colors hover:text-white">Hours &amp; directions</a>
                </div>
            </div>
        </div>
    </PagePanel>
</Layout>

---
import Layout from "../layouts/Layout.astro";
import PagePanel from "../components/PagePanel.astro";
import { Image } from "astro:assets";

const included = [
    "Two-bucket hand wash & foam pre-soak",
    "Wheels-off barrel & caliper cleaning",
    "Iron decon + full clay bar",
    "Bug and tar removal",
    "Trim and tire dressing",
    "Exterior glass cleaned & sealed",
    "Hand-applied sealant or wax",
    "Engine bay detail available",
];

const faqs = [
    ["Do you do paint correction or ceramic coatings?", "No. We're a wash, decontamination, and protection shop, and we'd rather do that properly than offer services we can't stand behind. If your paint needs correction, we're glad to recommend a shop that specializes in it."],
    ["What does decontamination actually do?", "A wash removes what's sitting on the paint; decontamination removes what's bonded into it — brake dust, rail dust, tar, and industrial fallout. It's why the paint feels like glass afterward instead of fine sandpaper."],
    ["How long does the protection last?", "A hand-applied wax runs roughly 6–8 weeks; a synthetic sealant holds up for about six months depending on how the car is stored and washed. We'll tell you which makes sense for your situation."],
];
---
<Layout title="Exterior Detailing — Bucks Premium Detailing">
    <PagePanel title="Exterior Detailing" eyebrow="Services">
        <svg slot="icon" class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M5 11l1.7-4.2A2 2 0 0 1 8.6 5.5h6.8a2 2 0 0 1 1.9 1.3L19 11M5 11h14M5 11a2 2 0 0 0-2 2v3h2m14-5a2 2 0 0 1 2 2v3h-2m-14 0v2h3v-2m-3 0h14m0 0v2h-3v-2"/>
        </svg>

        <div class="grid gap-10 lg:grid-cols-[1.2fr_1fr]">
            <div class="max-w-3xl">
                <p class="text-base leading-relaxed text-white/85 sm:text-lg">
                    Paint tells the truth. Bonded contamination, road film, and water spotting
                    dull even a freshly washed car — our exterior work removes what a wash
                    can't and protects what's underneath.
                </p>

                <h2 class="mt-12 text-xl font-semibold tracking-tight sm:text-2xl">Wash</h2>
                <p class="mt-3 text-base leading-relaxed text-white/70">
                    Foam pre-soak to lift the loose grit, then a two-bucket contact wash with
                    fresh media and filtered water. Wheels, barrels, and calipers are cleaned
                    separately with their own tools so brake dust never ends up on your paint.
                </p>

                <h2 class="mt-10 text-xl font-semibold tracking-tight sm:text-2xl">Decontamination</h2>
                <p class="mt-3 text-base leading-relaxed text-white/70">
                    Iron remover pulls the embedded brake and rail dust a wash leaves behind,
                    then a full clay bar treatment lifts tar, overspray, and industrial
                    fallout. The paint comes out genuinely clean and glass-smooth to the
                    touch — this is the step most people have never had done.
                </p>

                <h2 class="mt-10 text-xl font-semibold tracking-tight sm:text-2xl">Protection</h2>
                <p class="mt-3 text-base leading-relaxed text-white/70">
                    A hand-applied wax or synthetic sealant to lock in the finish, plus
                    dressed trim and tires and sealed glass. It keeps the car easier to wash,
                    sheds water properly, and buys the paint real protection through road
                    salt and summer sun.
                </p>

                <h2 class="mt-12 text-xl font-semibold tracking-tight sm:text-2xl">What's included</h2>
                <ul class="mt-5 grid gap-x-8 gap-y-3.5 sm:grid-cols-2">
                    {included.map((item) => (
                        <li class="flex items-start gap-3 text-base text-white/85">
                            <svg class="mt-1 size-4 shrink-0 text-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <path d="M5 13l4 4L19 7"/>
                            </svg>
                            {item}
                        </li>
                    ))}
                </ul>

                <h2 class="mt-12 text-xl font-semibold tracking-tight sm:text-2xl">Common questions</h2>
                <div class="mt-5 space-y-3">
                    {faqs.map(([q, a]) => (
                        <div class="rounded-[3px] border border-white/10 bg-black/40 p-6">
                            <h3 class="text-base font-medium">{q}</h3>
                            <p class="mt-2 text-sm leading-relaxed text-white/70">{a}</p>
                        </div>
                    ))}
                </div>

                <div class="mt-12 flex flex-wrap items-center gap-5 border-t border-white/10 pt-8">
                    <a href="/book" class="inline-flex items-center gap-2 rounded-[3px] bg-accent px-6 py-3.5 text-base font-medium text-black transition-all hover:brightness-90">
                        Book a Detail
                        <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M7 17L17 7M8 7h9v9"/>
                        </svg>
                    </a>
                    <a href="/services" class="text-base text-white/80 underline underline-offset-4 transition-colors hover:text-white">See packages &amp; pricing</a>
                </div>
            </div>

            <div class="hidden space-y-3 lg:block">
                <figure class="img-wrap relative h-[34rem] overflow-hidden rounded-[3px] opacity-0">
                    <Image src="https://images.pexels.com/photos/6873010/pexels-photo-6873010.jpeg?auto=compress&cs=tinysrgb&w=1000" alt="Exterior detailing in progress" width={1000} height={667} loading={"eager"}
                           class="absolute inset-0 h-full w-full object-cover"/>
                    <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent"></div>
                    <figcaption class="absolute bottom-5 left-5 text-sm text-white/85">Foam pre-soak before the contact wash</figcaption>
                </figure>
                <div class="rounded-[3px] border border-white/10 bg-black/40 p-6">
                    <h2 class="text-base font-semibold tracking-tight">Protection that lasts</h2>
                    <p class="mt-2 text-sm leading-relaxed text-white/70">
                        Every exterior package leaves with protection on the paint — a
                        hand-applied wax for roughly 6–8 weeks, or a synthetic sealant that
                        holds up for about six months.
                    </p>
                </div>
                <div class="rounded-[3px] border border-white/10 bg-black/40 p-6">
                    <h2 class="text-base font-semibold tracking-tight">Pairs well with</h2>
                    <p class="mt-2 text-sm leading-relaxed text-white/70">
                        A corrected, coated exterior deserves a matching cabin — the
                        Signature package bundles both sides at a better rate.
                    </p>
                    <a href="/interior" class="mt-3 inline-block text-sm text-white/80 underline underline-offset-4 transition-colors hover:text-white">Interior detailing</a>
                </div>
            </div>
        </div>
    </PagePanel>
</Layout>
